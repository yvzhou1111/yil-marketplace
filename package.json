{
  "name": "yil-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "YIL marketplace — bootstrap of the marketplace app",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^7.119.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.33.0",
    "jose": "^6.2.3",
    "next": "14.2.13",
    "pg": "8.13.0",
    "pino": "^9.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^16.12.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "2.1.1",
    "drizzle-kit": "0.24.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.13",
    "pino-pretty": "^11.3.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
