# --- App ---
DATABASE_URL=postgres://yil:yil@localhost:5432/yil_marketplace
NODE_ENV=development
PORT=3000

# --- Observability (YIL-12) ---
# Leave SENTRY_DSN blank to disable Sentry entirely (the app still runs).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# pino logger. In dev, set LOG_PRETTY=true for readable output.
LOG_LEVEL=info
LOG_PRETTY=false
# Comma-separated, additive on top of the defaults in src/lib/observability/redact.ts.
LOG_REDACT_PATHS=password,*.secret,token,*token*,authorization,cookie,set-cookie,credit_card,*.cc,*.ssn,*.tax_id,session,*.session

# Public URL of the prod deploy. The GitHub Actions uptime probe needs this.
UPTIME_PUBLIC_URL=http://localhost:3000

# --- Auth (YIL-4) ---
AUTH_SECRET=

# --- Payments (YIL-9) ---
# TEST MODE ONLY. The Stripe client (src/payments/stripe.ts) refuses to boot
# with a `sk_live_…` key — live keys are forbidden in this build.
# Get test keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Get the webhook signing secret from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (the CLI prints it on startup). NEVER commit a real value.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Pinned in code (see STRIPE_API_VERSION in src/payments/stripe.ts). Bump explicitly.

# --- Object storage (YIL-6 image upload) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=